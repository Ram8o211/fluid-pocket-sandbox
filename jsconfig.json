{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ]
  },
  "include": [
    "src/simulation/**/*.mjs",
    "src/materials/**/*.mjs",
    "src/reactions/**/*.mjs",
    "src/sensors/**/*.mjs",
    "src/performance/**/*.mjs",
    "src/game/**/*.mjs"
  ],
  "exclude": [
    "src/game/main.mjs",
    "src/game/art.mjs",
    "src/game/LaboratoryRenderer.mjs",
    "src/game/audio.mjs"
  ]
}
